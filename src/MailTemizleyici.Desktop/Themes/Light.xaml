<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F3ECFF" Offset="0"/>
        <GradientStop Color="#F8F5FD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9A5B" Offset="0"/>
        <GradientStop Color="#FF4D8D" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BgBrush" Color="#F8F5FD"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#99FFFFFF"/>
    <RadialGradientBrush x:Key="GlowABrush">
        <GradientStop Color="#40FF9A5B" Offset="0"/>
        <GradientStop Color="#00FF9A5B" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowBBrush">
        <GradientStop Color="#337C3AED" Offset="0"/>
        <GradientStop Color="#007C3AED" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="StripeBrush" Color="#0D7C3AED"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1F7C3AED"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D4C6EE"/>
    <SolidColorBrush x:Key="TextBrush" Color="#25123F"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5F4F80"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#B01F55"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#1B0B2E"/>
    <SolidColorBrush x:Key="KeepBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="TrashBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="UndecidedBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#337C3AED"/>
</ResourceDictionary>
