<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="WindowGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3A0F6B" Offset="0"/>
        <GradientStop Color="#1B0B45" Offset="0.55"/>
        <GradientStop Color="#120730" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9A5B" Offset="0"/>
        <GradientStop Color="#FF4D8D" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BgBrush" Color="#1B0B45"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#66120730"/>
    <RadialGradientBrush x:Key="GlowABrush">
        <GradientStop Color="#66FF4D8D" Offset="0"/>
        <GradientStop Color="#00FF4D8D" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowBBrush">
        <GradientStop Color="#667C3AED" Offset="0"/>
        <GradientStop Color="#007C3AED" Offset="1"/>
    </RadialGradientBrush>
    <SolidColorBrush x:Key="StripeBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F6F1FF"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#DDD2F7"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FFB4A8"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#1B0B2E"/>
    <SolidColorBrush x:Key="KeepBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="TrashBrush" Color="#FF8A8A"/>
    <SolidColorBrush x:Key="UndecidedBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="FocusBrush" Color="#FFD2A6"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#47FFFFFF"/>
</ResourceDictionary>
