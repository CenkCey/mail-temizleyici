<Window x:Class="MailTemizleyici.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MailTemizleyici.Desktop.ViewModels"
        xmlns:views="clr-namespace:MailTemizleyici.Desktop.Views"
        Style="{StaticResource {x:Type Window}}"
        Title="Mail Temizleyici" Width="1280" Height="760" MinWidth="1024" MinHeight="640" WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="68" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
            <views:ConnectionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalysisViewModel}">
            <views:AnalysisView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GroupsViewModel}">
            <views:GroupsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PreviewViewModel}">
            <views:PreviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubscriptionsViewModel}">
            <views:SubscriptionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="Root">
        <Ellipse Width="720" Height="720" Fill="{DynamicResource GlowABrush}" IsHitTestVisible="False"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-200,0"/>
        <Ellipse Width="820" Height="820" Fill="{DynamicResource GlowBBrush}" IsHitTestVisible="False"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-300,0,0,-360"/>
        <DockPanel Margin="12">
            <Border DockPanel.Dock="Left" Width="240" Margin="0,0,12,0" CornerRadius="20"
                    Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <DockPanel Margin="16,18,16,16">
                    <Button DockPanel.Dock="Bottom" Click="ToggleTheme_Click" HorizontalContentAlignment="Left"
                            Padding="14,0" MinHeight="44" Background="Transparent"
                            AutomationProperties.Name="Açık ve koyu tema arasında geçiş yap">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" Style="{StaticResource IconText}" Width="24"/>
                            <TextBlock Text="Tema değiştir" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,28">
                        <Image Source="/Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Mail Temizleyici" Style="{StaticResource SectionTitle}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="HAZIRLIK" Style="{StaticResource SectionLabel}" Margin="14,0,0,8"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" IsChecked="True" Tag="&#xE71B;"
                                     Content="Bağlantı" Command="{Binding ShowConnectionCommand}"
                                     AutomationProperties.Name="Bağlantı ekranını aç"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE8F1;"
                                     Content="Envanter" Command="{Binding ShowInventoryCommand}"
                                     AutomationProperties.Name="Envanter ekranını aç"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE9D9;"
                                     Content="Analiz" Command="{Binding ShowAnalysisCommand}"
                                     AutomationProperties.Name="Analiz özeti ekranını aç"/>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,16"/>
                        <TextBlock Text="KARAR VE İŞLEM" Style="{StaticResource SectionLabel}" Margin="14,0,0,8"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE716;"
                                     Content="Gönderen grupları" Command="{Binding ShowGroupsCommand}"
                                     AutomationProperties.Name="Gönderen grupları ekranını aç"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE71C;"
                                     Content="Abonelikler" Command="{Binding ShowSubscriptionsCommand}"
                                     AutomationProperties.Name="Abonelikler ekranını aç"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE7B3;"
                                     Content="Önizleme" Command="{Binding ShowPreviewCommand}"
                                     AutomationProperties.Name="Önizleme ve taşıma ekranını aç"/>
                        <RadioButton Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE81C;"
                                     Content="Geçmiş" Command="{Binding ShowHistoryCommand}"
                                     AutomationProperties.Name="Geçmiş ve geri alma ekranını aç"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Height="56" Margin="0,0,0,12" CornerRadius="16"
                    Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <DockPanel Margin="20,0,12,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Küçült" AutomationProperties.Name="Pencereyi küçült">
                            <TextBlock Text="&#xE921;" Style="{StaticResource IconText}" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Büyüt veya eski boyuta getir" AutomationProperties.Name="Pencereyi büyüt veya eski boyuta getir">
                            <TextBlock x:Name="MaxGlyph" Text="&#xE922;" Style="{StaticResource IconText}" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="Kapat" AutomationProperties.Name="Uygulamayı kapat">
                            <TextBlock Text="&#xE8BB;" Style="{StaticResource IconText}" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                        </Button>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="12" Padding="12,4" VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceAltBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="14"/>
                            <TextBlock Text="Yalnızca bu bilgisayarda" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Mail Temizleyici" Style="{StaticResource Muted}"/>
                        <TextBlock Text="&#xE76C;" Style="{StaticResource IconText}" FontSize="12" Margin="10,0"/>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ContentControl Content="{Binding Current}"/>
        </DockPanel>
    </Grid>
</Window>
