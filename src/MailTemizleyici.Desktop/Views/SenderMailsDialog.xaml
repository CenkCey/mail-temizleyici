<Window x:Class="MailTemizleyici.Desktop.Views.SenderMailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Width="980" Height="640" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Address}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Style="{StaticResource Muted}" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,12"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <DataGrid x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single"
                      MouseDoubleClick="List_MouseDoubleClick"
                      AutomationProperties.Name="Göndericiden gelen mailler">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tarih" Binding="{Binding DateText}" Width="110"/>
                    <DataGridTextColumn Header="Konu" Binding="{Binding Subject}" Width="*"
                                        ElementStyle="{StaticResource TrimCell}"/>
                    <DataGridTextColumn Header="Boyut" Binding="{Binding Size}" ElementStyle="{StaticResource NumberCell}"/>
                    <DataGridTextColumn Header="Durum" Binding="{Binding ReadText}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Gmail'de aç" Click="Open_Click"
                    IsEnabled="{Binding CanOpen}" Margin="0,0,8,0" MinHeight="36"
                    AutomationProperties.Name="Seçili maili Gmail'de tarayıcıda aç"/>
            <Button Content="Kapat" IsCancel="True" MinHeight="36"
                    AutomationProperties.Name="Pencereyi kapat"/>
        </StackPanel>
    </Grid>
</Window>
