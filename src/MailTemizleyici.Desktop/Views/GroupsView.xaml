<UserControl x:Class="MailTemizleyici.Desktop.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{DynamicResource FadeIn}"
             xmlns:views="clr-namespace:MailTemizleyici.Desktop.Views"
             xmlns:core="clr-namespace:MailTemizleyici.Core;assembly=MailTemizleyici.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitle}" Text="Gönderen grupları"/>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Grid Margin="0,0,12,0">
                <TextBox Width="280" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         x:Name="Search" Padding="36,0,12,0"
                         AutomationProperties.Name="Gönderen adresinde ara"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource IconText}" FontSize="14" Margin="12,0,0,0"
                           HorizontalAlignment="Left" IsHitTestVisible="False"/>
                <TextBlock Text="Gönderen ara…" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <RadioButton Style="{StaticResource Segment}" GroupName="f" Content="Tümü" IsChecked="True"
                         Command="{Binding SetFilterCommand}" CommandParameter="All"
                         AutomationProperties.Name="Tüm gönderenleri göster"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="f" Content="Koru"
                         Command="{Binding SetFilterCommand}" CommandParameter="Keep"
                         AutomationProperties.Name="Yalnızca Koru kararlı gönderenleri göster"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="f" Content="Sil"
                         Command="{Binding SetFilterCommand}" CommandParameter="Trash"
                         AutomationProperties.Name="Yalnızca Sil kararlı gönderenleri göster"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="f" Content="Kararsız"
                         Command="{Binding SetFilterCommand}" CommandParameter="Undecided"
                         AutomationProperties.Name="Yalnızca Kararsız gönderenleri göster"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="f" Content="Yıldızlılar"
                         Command="{Binding SetFilterCommand}" CommandParameter="Starred"
                         AutomationProperties.Name="Yıldızlı maili olan gönderenleri göster"/>
            <TextBlock Text="En az mail:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="c" Content="1" IsChecked="True"
                         Command="{Binding SetMinCommand}" CommandParameter="1"
                         AutomationProperties.Name="Tüm gönderenleri göster"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="c" Content="5"
                         Command="{Binding SetMinCommand}" CommandParameter="5"
                         AutomationProperties.Name="En az 5 maili olan gönderenleri göster"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="c" Content="10"
                         Command="{Binding SetMinCommand}" CommandParameter="10"
                         AutomationProperties.Name="En az 10 maili olan gönderenleri göster"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="c" Content="50"
                         Command="{Binding SetMinCommand}" CommandParameter="50"
                         AutomationProperties.Name="En az 50 maili olan gönderenleri göster"/>
            <Button Content="Güvenilir alanlar…" Click="Allowlist_Click" Margin="16,0,0,0"
                    AutomationProperties.Name="Her zaman korunacak alan adları listesini düzenle"/>
        </WrapPanel>

        <DockPanel Grid.Row="2" Margin="0,12,0,12">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Text="{Binding Status}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="130"/>
                <Button Content="Koru" Command="{Binding DecideCommand}" CommandParameter="Keep" Margin="0,0,4,0"
                        IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Seçili gönderenleri Koru olarak işaretle"/>
                <Button Content="Sil" Command="{Binding DecideCommand}" CommandParameter="Trash" Margin="0,0,4,0"
                        IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Seçili gönderenleri Sil olarak işaretle"/>
                <Button Content="Kararsız" Command="{Binding DecideCommand}" CommandParameter="Undecided" Margin="0,0,4,0"
                        IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Seçili gönderenleri Kararsız olarak işaretle"/>
                <Button Content="Mailleri incele…" Click="Inspect_Click" Margin="0,0,4,0"
                        IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Seçili göndericinin maillerini listele ve Gmail'de aç"/>
                <Button Content="Öneriye dön" Command="{Binding DecideCommand}" CommandParameter="Clear"
                        IsEnabled="{Binding HasSelection}"
                        AutomationProperties.Name="Seçili gönderenlerde kendi kararınızı kaldırıp öneriye dön"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8"
                Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
        <DataGrid x:Name="Grid" ItemsSource="{Binding Rows}" SelectionMode="Extended"
                  FrozenColumnCount="1" SelectionChanged="Grid_SelectionChanged" MouseDoubleClick="Grid_MouseDoubleClick"
                  AutomationProperties.Name="Gönderen grupları tablosu">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Gönderen" Binding="{Binding Address}" Width="300"
                                    ElementStyle="{StaticResource TrimCell}"/>
                <DataGridTemplateColumn Header="Karar" SortMemberPath="DecisionLabel" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="Badge" CornerRadius="10" BorderThickness="1" Padding="8,0"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding DecisionLabel}" x:Name="Label" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Effective}" Value="{x:Static core:Decision.Keep}">
                                    <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource KeepBrush}"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource KeepBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Effective}" Value="{x:Static core:Decision.Trash}">
                                    <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource TrashBrush}"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TrashBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Effective}" Value="{x:Static core:Decision.Undecided}">
                                    <Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource UndecidedBrush}"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource UndecidedBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" SortMemberPath="Source" Width="120"/>
                <DataGridTextColumn Header="Kural" Binding="{Binding RuleText}" Width="*"
                                    ElementStyle="{StaticResource TrimCell}"/>
                <DataGridTextColumn Header="Mail" Binding="{Binding Count, StringFormat=N0, ConverterCulture=tr-TR}" SortMemberPath="Count"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Yıldızlı" Binding="{Binding StarredText}" SortMemberPath="StarredCount"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Boyut" Binding="{Binding SizeText}" SortMemberPath="TotalSize"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Okunma %" Binding="{Binding ReadPercent}"
                                    ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Son mail" Binding="{Binding LastDateText}" SortMemberPath="LastDate" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Text="Gösterilecek gönderen yok. Önce Analiz ekranında analizi çalıştırın."
                   HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRows}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
