<UserControl x:Class="MailTemizleyici.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MailTemizleyici.Desktop.Views"
             Style="{DynamicResource FadeIn}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Envanter"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,20" TextWrapping="Wrap"
                           Text="Mail başlıkları (gönderen, konu, tarih, boyut, etiketler) bilgisayarınızdaki veritabanına alınır. Mail içeriği indirilmez ve hiçbir mail silinmez."/>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="İLERLEME" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource StatValue}"/>
                        <ProgressBar Margin="0,16,0,0" Minimum="0" Maximum="{Binding Total}" Value="{Binding Fetched}"
                                     AutomationProperties.Name="Envanter ilerlemesi"/>
                        <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,20,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Başlat / Devam et" Command="{Binding StartCommand}"
                            MinHeight="40"
                            AutomationProperties.Name="Envanteri başlat veya kaldığı yerden devam ettir"/>
                    <Button Content="Yeni mailleri al" Command="{Binding RefreshCommand}" Margin="8,0,0,0" MinHeight="40"
                            AutomationProperties.Name="Biten envanterden sonra gelen yeni mailleri al"/>
                    <Button Content="İptal" Command="{Binding CancelAllCommand}" Margin="8,0,0,0" MinHeight="40"
                            AutomationProperties.Name="Çalışan envanter işlemini durdur"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <views:SafetyPanel Grid.Column="2" VerticalAlignment="Top"/>
        </Grid>
        <views:StepsPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
