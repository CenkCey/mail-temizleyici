<UserControl x:Class="MailTemizleyici.Desktop.Views.SafetyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}">
        <StackPanel>
            <TextBlock Text="GÜVENCE" Style="{StaticResource SectionLabel}" Margin="0,0,0,16"/>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Her şey yerel" FontWeight="SemiBold"/>
                    <TextBlock Text="Veriler yalnızca bu bilgisayarda kalır, hiçbir üçüncü tarafa gitmez." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Yalnızca başlıklar" FontWeight="SemiBold"/>
                    <TextBlock Text="Mail içeriği hiç indirilmez; gönderen, konu, tarih ve boyut okunur." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Kalıcı silme yok" FontWeight="SemiBold"/>
                    <TextBlock Text="Mailler yalnızca çöp kutusuna taşınır ve 30 gün geri alınabilir." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7A7;" Style="{StaticResource IconText}" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Her işlem kayıtlı" FontWeight="SemiBold"/>
                    <TextBlock Text="Taşıma işlemleri Geçmiş ekranından geri alınabilir." Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
