<Window x:Class="MailTemizleyici.Desktop.Views.AllowlistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Güvenilir alanlar" Width="520" Height="520" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="Her zaman korunacak alan adları"/>
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"
                       Text="Her satıra bir alan adı yazın (örnek: bankam.com.tr). Alt alan adları da korunur. Bu alanlardan gelen mailler her zaman Koru olur."/>
        </StackPanel>
        <TextBox x:Name="Domains" Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" Padding="10,8"
                 AutomationProperties.Name="Güvenilir alan adları, her satırda bir tane"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Kaydet" Click="Save_Click" Margin="0,0,8,0" MinHeight="36"
                    AutomationProperties.Name="Alan adı listesini kaydet"/>
            <Button Content="Vazgeç" IsCancel="True" MinHeight="36" AutomationProperties.Name="Kaydetmeden kapat"/>
        </StackPanel>
    </Grid>
</Window>
