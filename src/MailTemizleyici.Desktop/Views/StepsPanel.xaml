<UserControl x:Class="MailTemizleyici.Desktop.Views.StepsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
        <Style x:Key="StepDesc" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StepIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        </Style>
        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="90"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Opacity" Value="0.07"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,-16"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="TEMİZLİK AKIŞI" Style="{StaticResource SectionLabel}" Margin="0,0,0,16"/>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,-12,-12">
                <Border Style="{StaticResource Tile}" Margin="0,0,12,12" Height="170">
                    <Grid>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="&#xE71B;" Style="{StaticResource StepIcon}"/>
                            <TextBlock Text="1. Bağlan" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Gmail'e yalnızca okuma izniyle giriş yapılır." Style="{StaticResource StepDesc}"/>
                        </StackPanel>
                        <TextBlock Text="1" Style="{StaticResource StepNumber}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,12,12" Height="170">
                    <Grid>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource StepIcon}"/>
                            <TextBlock Text="2. Envanter" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Mail başlıkları yerel veritabanına alınır." Style="{StaticResource StepDesc}"/>
                        </StackPanel>
                        <TextBlock Text="2" Style="{StaticResource StepNumber}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,12,12" Height="170">
                    <Grid>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource StepIcon}"/>
                            <TextBlock Text="3. Analiz" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Gönderenler gruplanır ve öneriler çıkarılır." Style="{StaticResource StepDesc}"/>
                        </StackPanel>
                        <TextBlock Text="3" Style="{StaticResource StepNumber}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,12,12" Height="170">
                    <Grid>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="&#xE716;" Style="{StaticResource StepIcon}"/>
                            <TextBlock Text="4. Karar" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Her grup için Koru, Sil veya Kararsız seçersiniz." Style="{StaticResource StepDesc}"/>
                        </StackPanel>
                        <TextBlock Text="4" Style="{StaticResource StepNumber}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,12,12" Height="170">
                    <Grid>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="&#xE7B3;" Style="{StaticResource StepIcon}"/>
                            <TextBlock Text="5. Önizleme" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Taşınacak mailler önce deneme olarak görülür." Style="{StaticResource StepDesc}"/>
                        </StackPanel>
                        <TextBlock Text="5" Style="{StaticResource StepNumber}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,12,12" Height="170">
                    <Grid>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource StepIcon}"/>
                            <TextBlock Text="6. Geri al" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="Çöp kutusuna taşınanlar geri alınabilir." Style="{StaticResource StepDesc}"/>
                        </StackPanel>
                        <TextBlock Text="6" Style="{StaticResource StepNumber}"/>
                    </Grid>
                </Border>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>
