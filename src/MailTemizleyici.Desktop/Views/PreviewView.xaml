<UserControl x:Class="MailTemizleyici.Desktop.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{DynamicResource FadeIn}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="Önizleme ve taşıma"/>
        <TextBlock Grid.Row="1" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="2" Margin="0,12,0,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" GroupName="m" Content="Deneme (küçük gruplar)"
                             IsChecked="{Binding TrialOnly}"
                             AutomationProperties.Name="Önce yalnızca küçük gönderen gruplarını dene"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="m" Content="Tümü"
                             AutomationProperties.Name="Sil kararlı tüm gönderenleri kapsa"/>
                <Button x:Name="Start" Content="Gerçek işlemi başlat…" Margin="12,0,0,0"
                        IsEnabled="{Binding HasPlan}" Click="Start_Click"
                        AutomationProperties.Name="Onay penceresini aç ve mailleri çöp kutusuna taşı"/>
                <Button Content="İptal" Command="{Binding TrashCancelCommand}" Margin="8,0,0,0"
                        AutomationProperties.Name="Çalışan taşıma işlemini durdur"/>
            </StackPanel>
            <CheckBox Content="Yıldızlı mailleri de dahil et" IsChecked="{Binding IncludeStarred}" Margin="0,12,0,0"
                      Foreground="{DynamicResource TextBrush}"
                      AutomationProperties.Name="Yıldızlı mailleri de çöp kutusuna taşıma planına dahil et"/>
            <ProgressBar Margin="0,12,0,0" Maximum="{Binding Total}" Value="{Binding Done}"
                         AutomationProperties.Name="Taşıma ilerlemesi"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Muted}"/>
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
        <DataGrid ItemsSource="{Binding Rows}" AutomationProperties.Name="Taşınacak gönderen grupları">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Gönderen" Binding="{Binding Sender}" Width="*"
                                    ElementStyle="{StaticResource TrimCell}"/>
                <DataGridTextColumn Header="Mail" Binding="{Binding Mails}" ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Boyut" Binding="{Binding Size}" ElementStyle="{StaticResource NumberCell}"/>
            </DataGrid.Columns>
        </DataGrid>
        </Border>
    </Grid>
</UserControl>
