<Window x:Class="MailTemizleyici.Desktop.Views.ConfirmTrashDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Çöp kutusuna taşımayı onayla" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource SectionTitle}" Text="Gerçek işlem: çöp kutusuna taşı"/>
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <CheckBox x:Name="BackupCheck" Margin="0,16,0,0" Foreground="{DynamicResource TextBrush}"
                  Content="Google Takeout yedeğimi aldım ve kontrol ettim."
                  AutomationProperties.Name="Takeout yedeğini aldığımı onaylıyorum"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="Cancel" Content="Vazgeç" IsCancel="True" IsDefault="True" Margin="0,0,8,0"
                    AutomationProperties.Name="Vazgeç, hiçbir şey yapma"/>
            <Button x:Name="Confirm" Content="Çöp kutusuna taşı" Click="Confirm_Click"
                    IsEnabled="{Binding IsChecked, ElementName=BackupCheck}"
                    Background="{DynamicResource TrashBrush}" Foreground="White" BorderBrush="{DynamicResource TrashBrush}"
                    AutomationProperties.Name="Seçili mailleri çöp kutusuna taşı"/>
        </StackPanel>
    </StackPanel>
</Window>
