<UserControl x:Class="MailTemizleyici.Desktop.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MailTemizleyici.Desktop.Views"
             Style="{DynamicResource FadeIn}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Bağlantı"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,20"
                           Text="Gmail hesabınıza yalnızca okuma izniyle bağlanın. Tarayıcıda Google girişi açılır."/>
                <UniformGrid Rows="1">
                    <Border Style="{StaticResource Tile}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="HESAP" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding Account}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="GMAİL&apos;DEKİ MAİL (ÇÖP KUTUSU HARİÇ)" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding TotalMessages}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,20,0,0"/>
                <ProgressBar IsIndeterminate="True" Margin="0,12,0,0"
                             Visibility="{Binding ConnectCommand.IsRunning, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Bağlan" Command="{Binding ConnectCommand}"
                            MinWidth="120" MinHeight="40"
                            AutomationProperties.Name="Gmail hesabına yalnızca okuma izniyle bağlan"/>
                    <Button Content="Hesap değiştir" Command="{Binding ConnectCommand}" CommandParameter="switch"
                            Margin="8,0,0,0" MinHeight="40"
                            AutomationProperties.Name="Oturumu kapat ve başka bir Gmail hesabıyla bağlan"/>
                    <Button Content="İptal" Command="{Binding ConnectCancelCommand}" Margin="8,0,0,0" MinHeight="40"
                            AutomationProperties.Name="Bağlantı denemesini iptal et"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <views:SafetyPanel Grid.Column="2" VerticalAlignment="Top"/>
        </Grid>
        <views:StepsPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
