<UserControl x:Class="MailTemizleyici.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{DynamicResource FadeIn}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageTitle}" Text="Geçmiş ve geri alma"/>
        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Seçili işlemi geri al…" Click="Undo_Click" IsEnabled="{Binding CanUndoSelected}"
                        AutomationProperties.Name="Seçili taşıma işlemini geri al"/>
                <Button Content="Tümünü geri al…" Click="UndoAll_Click" IsEnabled="{Binding CanUndoAny}" Margin="8,0,0,0"
                        AutomationProperties.Name="Çöp kutusunda duran tüm işlemleri geri al"/>
                <Button Content="İptal" Command="{Binding CancelUndoCommand}" Margin="8,0,0,0"
                        AutomationProperties.Name="Çalışan geri alma işlemini durdur"/>
            </StackPanel>
            <ProgressBar Margin="0,12,0,0" Maximum="{Binding Total}" Value="{Binding Done}"
                         AutomationProperties.Name="Geri alma ilerlemesi"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
        <DataGrid ItemsSource="{Binding Batches}" SelectedItem="{Binding Selected}" SelectionMode="Single"
                  AutomationProperties.Name="Çöp kutusuna taşıma işlemleri">
            <DataGrid.Columns>
                <DataGridTextColumn Header="İşlem no" Binding="{Binding BatchNo}" ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Tarih" Binding="{Binding DateText}" Width="120"/>
                <DataGridTextColumn Header="Durum" Binding="{Binding State}" Width="150"/>
                <DataGridTextColumn Header="Toplam mail" Binding="{Binding Total}" ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Çöp kutusunda" Binding="{Binding Active}" ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="Boyut" Binding="{Binding Size}" ElementStyle="{StaticResource NumberCell}"/>
            </DataGrid.Columns>
        </DataGrid>
        </Border>
    </Grid>
</UserControl>
